#!/usr/bin/env python3
"""@@NAME@@: bench scaffold (python -m ctf scaffold bench). Fill TARGET and cases(), then run:

    .venv/bin/python @@NAME@@.py --repeat 5               CPU seconds per case (min / median / max)
    .venv/bin/python @@NAME@@.py --cpu-budget 2.0         exit 1 when a case's median CPU exceeds 2 s
    .venv/bin/python @@NAME@@.py --profile --only base    cProfile top functions of one case

CPU time (time.process_time) is the measure: wall time on a loaded machine is shown for information
and is never a pass/fail bound.
"""
import sys
from pathlib import Path

sys.path.insert(0, "@@REPO@@")
from ctf import scaffold as S  # noqa: E402

TARGET = "@@TARGET@@"   # FILE.py:FUNCTION or package.module:FUNCTION


def cases():
    sample = Path("sample.bin")
    yield S.case("base", sample.read_bytes() if sample.is_file() else b"")


if __name__ == "__main__":
    sys.exit(S.bench_main(TARGET, cases))
